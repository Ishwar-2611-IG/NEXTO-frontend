# ==============================================================================
# NEXTO Frontend Environment Configuration (.env.example)
# Copy this file to `frontend/.env` to customize your local development settings.
# All variables exposed to the browser must be prefixed with VITE_.
# ==============================================================================

# API Base URL
# In development, Vite automatically proxies /api to http://127.0.0.1:5000.
# For production or direct cross-origin access, set this to your backend domain:
# e.g., VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1

# Optional: AI Stylist Service Proxy Endpoint
# If you run an AI stylist proxy service, specify the full URL here.
VITE_AI_STYLIST_PROXY_URL=

# Optional: Google Identity Services (OAuth)
# Use the same OAuth 2.0 Web Client ID configured in the backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Optional: Apple Sign-In Configuration
VITE_APPLE_AUTH_ENABLED=false
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
