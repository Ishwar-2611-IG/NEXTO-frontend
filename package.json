{
  "name": "nexto-streetwear",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NEXTO — streetwear e-commerce storefront (React + TypeScript + Tailwind)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
